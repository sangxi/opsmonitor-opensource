# ===== OpsMonitor 部署环境配置（模板）=====
# 复制本文件为 deploy/.env 后修改，deploy/.env 已被 .gitignore 忽略，不会进 git
#   cp deploy/.env.example deploy/.env
# 修改后重启服务：docker-compose -f deploy/docker-compose.yml up -d

# 数据库配置
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=wgcloud
DB_USER=wgcloud
DB_PASSWORD=请改成强密码

# 通信 token（Server 和 Agent 必须一致，建议 32 位以上随机字符串）
WGTOKEN=opsmonitor

# Server 端口（宿主机映射端口）
SERVER_PORT=9999

# Agent 配置
# Server URL（Docker 内部通信用容器名，外部部署用实际 IP）
SERVER_URL=http://opsmonitor-server:9999
# Agent 绑定 IP（为空时自动获取）
BIND_IP=
